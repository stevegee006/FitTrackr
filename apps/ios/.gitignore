# Generated by `npx cap add ios`. Committed deliberately — the Xcode project
# carries the widget target, signing config and Info.plist changes that cannot
# be regenerated from capacitor.config.ts.
#
# That comment was aspirational until 2026-09-24: nothing under ios/ had ever
# actually been committed, and moving to a new Mac cost two days rebuilding
# state the repo did not carry. See handoff Next step #0 and #141–#145.
#
# What must stay tracked, because none of it is reproducible:
#   project.pbxproj          the four targets, bundle ids, capabilities,
#                            deployment targets and target membership
#   *.entitlements           HealthKit and App Groups, per target
#   Info.plist               usage strings, WKBackgroundModes, the UIScene
#                            manifest (#141)
#   Podfile                  platform :ios, '17.0' — Xcode 27 rejects < 15.0,
#                            and `cap migrate` resets this (#143)
#   Podfile.lock             pinned pod versions
#   Assets.xcassets          icons and colours
#   Base.lproj/*.storyboard  Main.storyboard carries MainViewController's class,
#                            which is set in the Identity Inspector and exists
#                            NOWHERE in code (#142)
#   xcshareddata/xcschemes   the shared schemes

node_modules/

# Regenerated by `pod install`.
ios/App/Pods/

# Copied in by `cap sync` from apps/ios/www.
ios/App/App/public/

# Build output.
ios/DerivedData/
ios/App/build/

# Per-user Xcode state: breakpoints, window layout, last selected scheme.
# Changes on every launch and belongs to whoever opened the project.
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/

# Backups taken before a risky migration, e.g. ios.backup-20260924.
ios.backup-*/

.DS_Store
