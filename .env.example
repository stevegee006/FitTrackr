# Database
POSTGRES_USER=fittrackr
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fittrackr
DATABASE_URL=postgresql://fittrackr:changeme@localhost:5432/fittrackr

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret

# Encryption (for storing user API keys)
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string-64-chars

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Ports
API_PORT=4000
WEB_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
